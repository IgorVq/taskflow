# Modèle du .env de ~/taskflow-prod et ~/taskflow-staging (chmod 600, jamais dans Git).
# Un mot de passe différent par environnement : openssl rand -hex 24
POSTGRES_PASSWORD=changez-moi
DATABASE_URL=postgres://taskflow:${POSTGRES_PASSWORD}@db:5432/taskflow

# production ou staging
APP_ENV=production

# Compte GitHub en minuscules
GHCR_OWNER=votre-compte-github

# Prod (proxy) : 8082/8443 si 80/443 sont pris. Staging : FRONT_PORT.
HTTP_PORT=80
HTTPS_PORT=443
FRONT_PORT=8081
