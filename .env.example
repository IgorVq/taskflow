# ============================================================================
# Modèle de .env pour la prod (compose.prod.yaml) et le staging (compose.staging.yaml)
#
# Seul CE modèle est versionné. Le vrai .env se crée à la main, une fois par
# environnement, et ne quitte jamais son dossier :
#     cp .env.example ~/taskflow-prod/.env && chmod 600 ~/taskflow-prod/.env
#     PASS=$(openssl rand -hex 24) && sed -i '' "s/changez-moi/$PASS/" .env && unset PASS
#     (Linux : sed -i "s/.../.../" sans les '')
#
# Règle : un mot de passe DIFFÉRENT par environnement (une fuite du staging ne
# doit pas ouvrir la prod). Le dev (compose.yaml) n'a pas besoin de ce fichier.
# ============================================================================

# --- Base de données ---------------------------------------------------------
# Écrit UNE seule fois : compose.*.yaml construit DATABASE_URL à partir de lui.
# Hexadécimal (openssl rand -hex 24) : aucun caractère qui casserait l'URL.
# Postgres ne le lit qu'à la CRÉATION du volume : le changer ensuite ne suffit pas.
POSTGRES_PASSWORD=changez-moi

# --- Application --------------------------------------------------------------
# production dans ~/taskflow-prod, staging dans ~/taskflow-staging (affiché par /health)
APP_ENV=production

# --- Images -------------------------------------------------------------------
# Compte GitHub propriétaire des images ghcr.io, EN MINUSCULES (exigé par le registre).
GHCR_OWNER=votre-compte-github
# Pas de IMAGE_TAG ici : la version est choisie à chaque déploiement (./deploy.sh <sha>).

# --- Ports publiés ------------------------------------------------------------
# Prod : seul le proxy publie. Si 80/443 sont pris : 8082 et 8443.
HTTP_PORT=80
HTTPS_PORT=443
# Staging : le front est publié directement.
FRONT_PORT=8081
